<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <!-- New in 1.1: no baseline package exists yet; enable once 1.1 ships. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageValidationOptOutReason>New in 1.1; no released baseline exists yet. Validate against the 1.1.0 baseline after it publishes (RELEASING.md).</PackageValidationOptOutReason>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>prototest</ToolCommandName>
    <PackageId>ProtoTest.Cli</PackageId>
    <Description>Command-line access to ProtoTest evidence: the failure digest, the feedback channels and the cross-run verdict without a browser.</Description>
    <PackageTags>testing;trace;cli;tool;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Diagnosis\ProtoTest.Diagnosis.csproj" />
    <ProjectReference Include="..\ProtoTest.Feedback\ProtoTest.Feedback.csproj" />
    <ProjectReference Include="..\ProtoTest.Traces\ProtoTest.Traces.csproj" />
    <ProjectReference Include="..\ProtoTest.Verification\ProtoTest.Verification.csproj" />
  </ItemGroup>
</Project>
