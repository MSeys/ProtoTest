<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <Version>0.1.0-alpha</Version>
    <Authors>Matthias Seys</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/MSeys/ProtoTest</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Marks every ProtoTest package, so a trace can tell the suite's own frames from ProtoTest's. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <AssemblyMetadata Include="ProtoTest.Framework" Value="true" />
  </ItemGroup>

  <!-- One mark for the whole family: on nuget.org every ProtoTest package reads as part of the same set. -->
  <!-- Read only when packing; a project's own IsPackable is not known yet here, so no condition. -->
  <PropertyGroup>
    <PackageIcon>prototest-package-icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets/brand/prototest-package-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- One lock alias for every project: the runtime's Lock where it exists, object otherwise. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Using Include="System.Object" Alias="ProtoLock" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">
    <Using Include="System.Threading.Lock" Alias="ProtoLock" />
  </ItemGroup>
</Project>
