<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <IsPackable>true</IsPackable>
    <PackageId>ProtoTest.WireMock</PackageId>
    <Description>Fake HTTP services for ProtoTest suites, backed by WireMock.Net: per-test stubs, matched-request trace evidence and stub coverage.</Description>
    <PackageTags>testing;integration-testing;http;fake;wiremock;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
    <ProjectReference Include="..\ProtoTest.Http\ProtoTest.Http.csproj" />
    <ProjectReference Include="..\ProtoTest.Rest\ProtoTest.Rest.csproj" />
    <PackageReference Include="WireMock.Net" />
    <!-- WireMock.Net's Handlebars helpers ask for the Humanizer metapackage from 2.14.1 up; pinning
         the resolved line to 3.0.10 aligns its satellite set with the Humanizer.Core 3.0.10 that
         Aspire.Hosting restores, so a suite using ProtoTest.Aspire and ProtoTest.WireMock together
         restores one Humanizer line. -->
    <PackageReference Include="Humanizer" />
  </ItemGroup>

</Project>
