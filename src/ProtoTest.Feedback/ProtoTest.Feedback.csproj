<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>ProtoTest.Feedback</PackageId>
    <Description>Posts a ProtoTest run's failure digest where a pull request reads it: a comment with the trace link, check annotations, and a webhook for a machine consumer.</Description>
    <PackageTags>testing;trace;feedback;ci;agent;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Diagnosis\ProtoTest.Diagnosis.csproj" />
    <ProjectReference Include="..\ProtoTest.Verification\ProtoTest.Verification.csproj" />
  </ItemGroup>
</Project>
