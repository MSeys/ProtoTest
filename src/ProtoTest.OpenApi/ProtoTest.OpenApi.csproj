<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>OpenAPI contract coverage for ProtoTest REST tests.</Description>
    <PackageTags>testing;integration-testing;openapi;contract-testing;coverage;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
    <ProjectReference Include="..\ProtoTest.Http\ProtoTest.Http.csproj" />
    <ProjectReference Include="..\ProtoTest.Rest\ProtoTest.Rest.csproj" />
    <PackageReference Include="Microsoft.OpenApi" />
    <!-- YAML documents are a separate reader in 2.x; 1.x read them out of the box. -->
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
  </ItemGroup>

</Project>
