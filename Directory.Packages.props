<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The Microsoft.Extensions family floats on its patch version per target framework. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <!-- One version per package for the whole repository. -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageVersion Include="Google.Protobuf" Version="3.31.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.70.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.70.0" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.6.3" />
    <PackageVersion Include="HotChocolate.Language" Version="16.6.3" />
    <PackageVersion Include="HotChocolate.Subscriptions.InMemory" Version="16.6.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="3.10.2" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="MSTest" Version="4.4.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Selenium.WebDriver" Version="4.49.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageVersion Include="TUnit" Version="1.66.0" />
    <PackageVersion Include="TUnit.Core" Version="1.66.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.execution" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0" />
  </ItemGroup>

  <!--
    The Microsoft.Extensions family, EF Core and the ASP.NET Core test host follow the target
    framework, so a net8 host keeps its net8 dependencies while net9 and net10 builds stay current.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.*" />
  </ItemGroup>
</Project>
