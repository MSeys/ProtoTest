<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>ProtoTest.Grpc</PackageId>
    <AssemblyName>ProtoTest.Grpc</AssemblyName>
    <RootNamespace>ProtoTest.Grpc</RootNamespace>
    <Description>gRPC integration for ProtoTest: named channels, metadata authentication, unary and streaming helpers, tracing and coverage.</Description>
    <PackageTags>testing;integration-testing;grpc;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
    <ProjectReference Include="..\ProtoTest.Http\ProtoTest.Http.csproj" />
    <ProjectReference Include="..\ProtoTest.Json\ProtoTest.Json.csproj" />
  </ItemGroup>

</Project>

