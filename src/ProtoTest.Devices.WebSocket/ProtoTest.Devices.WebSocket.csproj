<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- New in 1.1: no released baseline exists yet, so there is nothing to validate against. -->
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>false</EnablePackageValidation>
    <Description>WebSocket transport for ProtoTest.Devices: talk to devices over ws:// or wss://.</Description>
    <PackageTags>testing;integration-testing;devices;websocket;iot;ocpp;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Devices\ProtoTest.Devices.csproj" />
  </ItemGroup>

</Project>
