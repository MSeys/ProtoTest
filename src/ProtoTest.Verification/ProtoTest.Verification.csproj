<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>Cross-run verification over ProtoTest reports and traces: coverage deltas, specification identity, run comparison and a verdict a PR gate can use.</Description>
    <PackageTags>testing;integration-testing;verification;coverage;ci;agent;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Reporting\ProtoTest.Reporting.csproj" />
    <ProjectReference Include="..\ProtoTest.Traces\ProtoTest.Traces.csproj" />
  </ItemGroup>

</Project>
