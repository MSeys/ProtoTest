<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <!-- New in 1.1: no baseline package exists yet; enable once 1.1 ships. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageValidationOptOutReason>New in 1.1; no released baseline exists yet. Validate against the 1.1.0 baseline after it publishes (RELEASING.md).</PackageValidationOptOutReason>
    <PackageId>ProtoTest.Diagnosis</PackageId>
    <Description>Deterministic diagnosis of a .prototrace run: the causal failure summary, its context package, and the digest the CLI, the MCP tools and the feedback channels share.</Description>
    <PackageTags>testing;trace;diagnosis;agent;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Traces\ProtoTest.Traces.csproj" />
  </ItemGroup>
</Project>
