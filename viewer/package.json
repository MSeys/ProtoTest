{
  "name": "prototest-trace-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --environment jsdom",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run lint:css && npm run lint:ts && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "scale:measure": "node scripts/measure-viewer.mjs",
    "scale:trace": "node scripts/generate-scale-trace.mjs",
    "lint:ts": "eslint",
    "lint:css": "stylelint \"src/**/*.{css,vue}\" \"../src/ProtoTest.Reporting/Sinks/HtmlReportAssets/*.css\""
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^30.1.0",
    "postcss-html": "^1.8.1",
    "puppeteer-core": "^25.12.0",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.11"
  }
}
