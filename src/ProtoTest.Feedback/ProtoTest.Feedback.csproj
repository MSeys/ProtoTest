<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <!-- New in 1.1: no baseline package exists yet; enable once 1.1 ships. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageValidationOptOutReason>New in 1.1; no released baseline exists yet. Validate against the 1.1.0 baseline after it publishes (RELEASING.md).</PackageValidationOptOutReason>
    <PackageId>ProtoTest.Feedback</PackageId>
    <Description>Posts a ProtoTest run's failure digest where a pull request reads it: a comment with the trace link, check annotations, and a webhook for a machine consumer.</Description>
    <PackageTags>testing;trace;feedback;ci;agent;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Diagnosis\ProtoTest.Diagnosis.csproj" />
  </ItemGroup>
</Project>
