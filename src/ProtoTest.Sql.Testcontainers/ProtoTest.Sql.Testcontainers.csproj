<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>ProtoTest.Sql.Testcontainers</PackageId>
    <Description>A database container owned as a run-scoped resource for ProtoTest.Sql.</Description>
    <PackageTags>testing;integration-testing;database;postgres;testcontainers;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
    <ProjectReference Include="..\ProtoTest.Testcontainers\ProtoTest.Testcontainers.csproj" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

</Project>
