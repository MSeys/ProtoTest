<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>prototest-mcp</ToolCommandName>
    <PackageId>ProtoTest.Mcp</PackageId>
    <Description>Read-only MCP server over .prototrace evidence: an agent lists runs, reads a failure and reads coverage without leaving the machine.</Description>
    <PackageTags>testing;trace;mcp;agent;tool;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Diagnosis\ProtoTest.Diagnosis.csproj" />
    <ProjectReference Include="..\ProtoTest.Traces\ProtoTest.Traces.csproj" />
    <ProjectReference Include="..\ProtoTest.Verification\ProtoTest.Verification.csproj" />
  </ItemGroup>
</Project>
