<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <IsPackable>true</IsPackable>
    <Description>MQTT transport for ProtoTest.Devices: talk to devices over publish/subscribe against a real broker.</Description>
    <PackageTags>testing;integration-testing;devices;mqtt;iot;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Devices\ProtoTest.Devices.csproj" />
    <PackageReference Include="MQTTnet" />
  </ItemGroup>

</Project>
