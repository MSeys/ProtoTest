<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- No 1.0.1 baseline exists for this package; validate once 1.1 ships. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <IsPackable>true</IsPackable>
    <Description>Talk to devices - simulators or hardware - from the same test context, lifecycle and trace.</Description>
    <PackageTags>testing;integration-testing;devices;iot;ocpp;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
  </ItemGroup>

</Project>
