<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
  	<PackageId>ProtoTest.Core</PackageId>
  	<Version>0.1.0-alpha</Version>
  	<Authors>Matthias Seys</Authors>
  	<Description>Bringing back the simplicity and readability of prototyping to .NET integration testing.</Description>
  	<PackageLicenseExpression>MIT</PackageLicenseExpression>
  	<PackageTags>testing;integration-testing;dependency-injection;dotnet</PackageTags>
  	<RepositoryUrl>https://github.com/matthiasseys/ProtoTest</RepositoryUrl>
  	<RepositoryType>git</RepositoryType>
  	<IncludeSymbols>true</IncludeSymbols>
  	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
  	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
