<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <!-- New in 1.1: no baseline package exists yet; enable once 1.1 ships. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageId>ProtoTest.Traces</PackageId>
    <Description>Reader for .prototrace archives: the run, its tests and each test's operations without a dependency on ProtoTest.Core.</Description>
    <PackageTags>testing;trace;diagnostics;reader;dotnet</PackageTags>
  </PropertyGroup>
</Project>
