<Project>
  <!--
    Compatibility guard for the published packages: validate every packable project against the last
    released baseline (1.1.0) and fail the pack when a public API changes without a recorded
    suppression. Directory.Build.props runs before a project sets IsPackable, so the condition lives
    here, in the targets pass. A project may opt out by setting EnablePackageValidation itself, with a
    PackageValidationOptOutReason, when it has no released baseline to restore.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <EnablePackageValidation Condition="'$(EnablePackageValidation)' == ''">true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(PackageValidationBaselineVersion)' == ''">1.1.5</PackageValidationBaselineVersion>
  </PropertyGroup>
</Project>
