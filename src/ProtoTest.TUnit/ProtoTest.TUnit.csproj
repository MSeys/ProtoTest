<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>TUnit lifecycle and attachment integration for ProtoTest.</Description>
    <PackageTags>testing;integration-testing;tunit;dependency-injection;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" Version="1.66.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
  </ItemGroup>

</Project>
