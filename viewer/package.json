{
  "name": "prototest-trace-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --environment jsdom",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run lint:css && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:css": "stylelint \"src/**/*.{css,vue}\""
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^30.1.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
