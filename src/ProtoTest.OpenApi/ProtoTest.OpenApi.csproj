<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>OpenAPI contract coverage for ProtoTest REST tests.</Description>
    <PackageTags>testing;integration-testing;openapi;contract-testing;coverage;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
    <ProjectReference Include="..\ProtoTest.Http\ProtoTest.Http.csproj" />
    <ProjectReference Include="..\ProtoTest.Rest\ProtoTest.Rest.csproj" />
    <!-- Documents are read by ProtoTest itself, so the package never imposes an OpenAPI library version on
         the application a suite hosts. YAML is converted with YamlDotNet's representation model. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
