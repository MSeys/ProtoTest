<Project>
  <!--
    MSBuild stops at the nearest Directory.Build.props, so this chains to the repository root one.
    Test projects declare only what makes them a test project; the shared shape lives here.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Tests ship nowhere, so their PDBs keep real paths: source locations and [CallerFilePath]
         helpers find the repository the same way on a laptop and in CI, where CI=true would map them to /_/. -->
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="ProtoTest.TestSupport" />
  </ItemGroup>
</Project>
