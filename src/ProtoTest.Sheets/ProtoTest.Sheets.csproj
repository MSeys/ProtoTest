<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>ProtoTest.Sheets</PackageId>
    <AssemblyName>ProtoTest.Sheets</AssemblyName>
    <RootNamespace>ProtoTest.Sheets</RootNamespace>
    <Description>Spreadsheet integration for ProtoTest: open generated workbooks with ordinary OpenXML and assert on sheets, cells and ranges, with coverage.</Description>
    <PackageTags>testing;integration-testing;spreadsheet;excel;openxml;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
  </ItemGroup>

</Project>
