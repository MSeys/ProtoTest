<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>
	<IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
  	<PackageId>ProtoTest.NUnit</PackageId>
	<Description>NUnit adapter for ProtoTest, bringing frictionless lifecycle management and dependency injection to your test suites.</Description>
	<PackageTags>testing;integration-testing;nunit;dependency-injection;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
  </ItemGroup>

</Project>
