<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>ProtoTest.Reporting</PackageId>
    <IsPackable>true</IsPackable>
    <Description>JSON and self-contained HTML reporting for ProtoTest observations and coverage.</Description>
    <PackageTags>testing;integration-testing;reporting;coverage;html;json;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Core\ProtoTest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\brand\prototest-mark-transparent.svg" LogicalName="ProtoTest.Reporting.BrandMark.svg" />
    <EmbeddedResource Include="..\..\assets\brand\prototest-mark-blueprint.svg" LogicalName="ProtoTest.Reporting.BlueprintMark.svg" />
  </ItemGroup>

</Project>
