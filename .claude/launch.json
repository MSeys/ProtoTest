{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "docs", "run", "start", "--", "--port", "3100"],
      "port": 3100
    },
    {
      "name": "docs-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "docs", "run", "serve", "--", "--port", "3101", "--no-open"],
      "port": 3101
    },
    {
      "name": "viewer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "viewer", "run", "dev", "--", "--port", "5273"],
      "port": 5273
    }
  ]
}
