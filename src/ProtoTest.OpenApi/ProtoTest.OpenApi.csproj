<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>
	<IsPackable>true</IsPackable>
	<Description>OpenAPI contract coverage for ProtoTest REST tests.</Description>
	<PackageTags>testing;integration-testing;openapi;contract-testing;coverage;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Http\ProtoTest.Http.csproj" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoTest.Rest\ProtoTest.Rest.csproj" />
  </ItemGroup>

</Project>
